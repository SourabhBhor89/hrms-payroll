						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"permissionIds\": [1, 2, 4, 5, 10, 11]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/users/:userId/permissions",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"users",
								":userId",
								"permissions"
							],
							"variable": [
								{
									"key": "userId",
									"value": "2",
									"description": "Target Employee User ID"
								}
							]
						},
						"description": "Replaces all permissions for an employee user with a specific list of permission IDs (Allowed for ADMIN and HR)."
					},
					"response": []
				},
				{
					"name": "Add Single Permission to User",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/users/:userId/permissions?permissionId=3",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"users",
								":userId",
								"permissions"
							],
							"query": [
								{
									"key": "permissionId",
									"value": "3",
									"description": "Permission ID to add (e.g. 3 = ATTENDANCE_UPDATE)"
								}
							],
							"variable": [
								{
									"key": "userId",
									"value": "2",
									"description": "Target Employee User ID"
								}
							]
						},
						"description": "Adds a single permission to an employee user."
					},
					"response": []
				},
				{
					"name": "Remove Single Permission from User",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/users/:userId/permissions/:permissionId",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"users",
								":userId",
								"permissions",
								":permissionId"
							],
							"variable": [
								{
									"key": "userId",
									"value": "2",
									"description": "Target Employee User ID"
								},
								{
									"key": "permissionId",
									"value": "3",
									"description": "Permission ID to remove"
								}
							]
						},
						"description": "Deactivates a single permission for an employee user."
					},
					"response": []
				}
			]
